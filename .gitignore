# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenvs
.venv/
venv/

# uv
uv.lock

# Build artifacts
build/
dist/
*.dmg
*.app

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Local dev scratch
scratch/
*.local.*

# Claude Code local state (settings.local.json has personal permission
# allowlist and machine-specific paths; worktrees/ is session scratch).
.claude/

# Nora per-run state inside researcher project dirs (session cwd's
# .nora/ holds results.db, chat_history.jsonl, runs/, etc.). Older
# checkouts may also have .builder/ from before the rename.
.nora/
.builder/

# Hypothesis example database.
.hypothesis/

# Cache-busted index.html copies the bridge writes at launch
# (src/nora/ui.py:_materialize_cache_busted_index). Per-launch hash
# in the filename so WKWebView reloads JS/CSS — runtime artifact,
# never source.
src/nora/web/.index.bust-*.html

# Researcher-produced audit / run logs. These can carry data-derived
# values (varnames, partial diagnostics) from a real session and must
# never be staged. Pattern covers the canonical names produced by
# ``packaging/release.sh`` smoke runs and ad-hoc Stata audit dumps.
audit.log
audit_*.log
*.audit.log
